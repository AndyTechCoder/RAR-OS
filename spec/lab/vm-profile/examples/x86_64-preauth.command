emulator=qemu-system-x86_64
runtime_seconds=60
output_bytes=1048576
arg=-machine
arg=q35,accel=tcg
arg=-cpu
arg=max
arg=-smp
arg=2
arg=-m
arg=512
arg=-no-user-config
arg=-nodefaults
arg=-no-reboot
arg=-no-shutdown
arg=-display
arg=none
arg=-serial
arg=stdio
arg=-monitor
arg=none
arg=-nic
arg=none
arg=-sandbox
arg=on,obsolete=deny,elevateprivileges=deny,spawn=deny,resourcecontrol=deny
arg=-drive
