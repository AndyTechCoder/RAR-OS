transcript_framing=lf-terminated-lines,pipe-delimited-body,no-empty-line,no-leading-or-trailing-byte
transcript_header_rule=exactly-two-lines,canonical-order,no-unknown+missing+duplicate-header
transcript_body_rule=exactly-one-row-per-selected-plan-row,canonical-plan-order,exactly-eight-fields,no-empty-field,no-unknown-field
transcript_bound=maximum-1048576-bytes,maximum-45-body-rows
transcript_sequence_rule=unsigned-canonical-decimal-1..45,starts-1,increments-1
transcript_offset_rule=unsigned-canonical-decimal-0..8388608,before-less-than-after,after-at-real-lf-byte,marker-line-start-at-or-after-before
transcript_digest_rule=lowercase-sha256-64-or-literal-none,capture-flag-controls-digest-form,capture-file-digest-matches
transcript_unknown_rule=reject-any-extra-header+body-field+line+byte+selected-or-future-marker
transcript_persistence=retained-alpha-evidence,reader+writer+verifier-owned-by-reviewed-controller-closure,no-target-reader
transcript_migration=v1-read-only-historical,v1-rejected-for-new-probes,no-in-place-rewrite,no-downgrade
transcript_replacement=new-version+new-digest+new-review,never-silent-mutation
historical_rule=v1-immutable-and-rejected-for-every-new-A-G-probe-after-v2-cutover
change_rule=exactly-v1-schema-version+three-input-fields+one-minimum-field,no-other-row-change
