offset_rule=unsigned-decimal-byte-offset,strictly-increasing-after,marker-complete-line-ends-at-after
selection_rule=preserve-physical-order,select-row-when-minimum-rank-less-than-or-equal-probe-rank
marker_rule=exact-complete-serial-line,unique-in-selected-transcript,no-missing,no-duplicate,no-reorder,no-stale,no-extra-selected-descendant
capture_rule=immediately-after-selected-marker,exact-label-ppm,final-ppm-after-all-selected-rows
transcript_schema=rar-alpha-action-transcript-v2
