schema=rar-alpha-accepted-evidence-contract-v0
status=experimental-inactive
owner=trusted-development-controller-phase-8
record_schema=rar-alpha-accepted-evidence-v0
encoding=ascii-lowercase-keys,lf-terminated,key-equals-value,no-cr,no-nul,no-empty-line
framing=exactly-20-lines,canonical-order,no-unknown+missing+duplicate-key,no-leading+trailing-byte
maximum_bytes=4096
field|schema|literal:rar-alpha-accepted-evidence-v0
field|attempt_nonce|lower-hex-nonzero:64
field|probe|enum:milestone-a,milestone-b,milestone-c,milestone-d,milestone-e,milestone-f,milestone-g
field|controller_revision|lower-hex-nonzero:40
field|source_revision|lower-hex-nonzero:40
field|artifact_sha256|lower-hex-nonzero:64
field|acceptance_protocol_sha256|literal:ffdb07b584abc94122b14a416593916cf18df439de042c97ff83fda9e4444ccd
field|machine_profile_sha256|lower-hex-nonzero:64
field|qemu_sha256|lower-hex-nonzero:64
field|firmware_sha256|lower-hex-nonzero:64
field|qmp_client_sha256|lower-hex-nonzero:64
field|actions_sha256|lower-hex-nonzero:64
field|serial_sha256|lower-hex-nonzero:64
field|final_capture_sha256|lower-hex-nonzero:64
field|capture_set_sha256|lower-hex-nonzero:64
field|handoff_manifest_set_sha256|lower-hex-nonzero:64
field|reference_verdict_sha256|lower-hex:64,zero-only-A-E,nonzero-only-F-G
field|role_inventories_sha256|lower-hex-nonzero:64
field|accepted_outputs_sha256|lower-hex-nonzero:64
field|record_sha256|lower-hex-nonzero:64,sha256-lines-1-through-19-exact-bytes
identity_rule=all-expected-values-supplied-by-trusted-phase-8-controller,never-from-launch-output-or-target
attempt_rule=fresh-random-controller-attempt-nonce,unique-per-probe-attempt,no-reuse,retry-gets-new-nonce
output_rule=actions+serial+final+canonical-capture-set-digests-recomputed-after-descriptor-handoff
set_line_rule=label+equals+lowercase-sha256+lf,label-lowercase-ascii-[a-z0-9.-],lexicographic-byte-order,no-empty+unknown+duplicate
capture_set_members=exact-selected-plan-label-dot-ppm-for-each-capture-1-row,no-final-dot-ppm
handoff_manifest_set_members=build-artifact-dot-manifest,build-transcript-dot-manifest,launch-evidence-dot-manifest,plus-reference-comparison-evidence-dot-manifest-only-F-G
role_inventories_members=build-image,launch-image,compiler-closure,linker,firmware,machine-profile,qemu,qmp-client,plus-reference-image+crypto-inventory+reference-1+reference-2+reference-harness-only-F-G
accepted_outputs_members=actions-dot-v2,serial-dot-log,final-dot-ppm,capture-set,handoff-manifest-set,reference-verdict,role-inventories
set_digest_rule=sha256-exact-concatenated-set-lines,each-member-digest-recomputed-from-post-handoff-controller-owned-file
reference_rule=A-E-zero-verdict,F-G-exact-accepted-reference-verdict
verification_precondition=record-is-post-handoff-controller-owned-immutable-copy,no-concurrent-writer,regular+mode-0600+nlink-1,semantic-verifier-grants-no-publication-authority
publication_rule=future-phase-8-writer-required-before-activation,new-no-follow+mode-0600+same-fd-parse+hash+identity-recheck+fdatasync+parent-fsync
replay_rule=any-attempt+probe+controller+source+artifact+protocol+profile+tool+output+handoff+reference+inventory-mismatch-rejects
downgrade_rule=v0-exact-only,missing-record+older-protocol+unknown-version-rejects
retention_rule=record+bound-outputs-retained-together,record-alone-is-never-acceptance
replacement_rule=new-version+new-contract+new-review,no-in-place-reinterpretation
activation_rule=writer+verifier+fixtures+controller+profile-reviewed-merged-and-exact-main-validated
