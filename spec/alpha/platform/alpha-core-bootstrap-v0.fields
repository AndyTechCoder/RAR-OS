schema=rar-alpha-core-bootstrap-v0
status=experimental-pending-review
byte_order=little-endian
parser_owner=Nucleus-Alpha-adapter
policy_scope=one-fixed-Core-bootstrap-only,no-component-selection,no-dependency-resolution,no-lifecycle-policy
header_bytes=128
segment_record_bytes=48
segment_count=1..8
total_maximum_bytes=4194304
mapped_memory_maximum_bytes=8388608
mapped_memory_calculation=sum-page-round-up-each-segment-memory-bytes+stack-bytes+page-table-bytes,checked,less-than-or-equal-mapped-memory-maximum
virtual_window=0x0000000040000000..0x0000000041000000
stack_slot=0x0000000040f00000..0x0000000040f10000
stack_guard=0x0000000040f00000..0x0000000040f01000
page_table_maximum_bytes=262144
segment_memory_maximum_bytes=4194304
aggregate_bss_maximum_bytes=4194304
aggregate_bss_calculation=sum-memory-bytes-minus-file-bytes,checked,less-than-or-equal-aggregate-BSS-maximum
initial_thread_count=1
initial_capability_count=3
initial_ipc_endpoint_count=1
wire_field|AlphaCoreHeaderV0|0|magic|bytes:8|RARCORE0
wire_field|AlphaCoreHeaderV0|8|major|u16|0
wire_field|AlphaCoreHeaderV0|10|minor|u16|0
wire_field|AlphaCoreHeaderV0|12|header_bytes|u32|128
wire_field|AlphaCoreHeaderV0|16|total_bytes|u64|computed
wire_field|AlphaCoreHeaderV0|24|segment_table_offset|u64|128
wire_field|AlphaCoreHeaderV0|32|segment_count|u32|1..8
wire_field|AlphaCoreHeaderV0|36|segment_record_bytes|u32|48
wire_field|AlphaCoreHeaderV0|40|entry_virtual_address|u64|inside-one-RX-segment
wire_field|AlphaCoreHeaderV0|48|artifact_identity|bytes:32|ADR-0028
wire_field|AlphaCoreHeaderV0|80|contract_identity|bytes:32|this-contract
wire_field|AlphaCoreHeaderV0|112|flags|u32|zero
wire_field|AlphaCoreHeaderV0|116|reserved|bytes:12|zero
wire_field|AlphaCoreSegmentV0|0|virtual_address|u64|page-aligned-in-window
wire_field|AlphaCoreSegmentV0|8|file_offset|u64|page-congruent
wire_field|AlphaCoreSegmentV0|16|file_bytes|u64|bounded
wire_field|AlphaCoreSegmentV0|24|memory_bytes|u64|file-bytes-or-greater
wire_field|AlphaCoreSegmentV0|32|flags|u32|R-or-RW-or-RX
wire_field|AlphaCoreSegmentV0|36|alignment|u32|4096
wire_field|AlphaCoreSegmentV0|40|reserved|u64|zero
core_segment_flag|0x00000001|read
core_segment_flag|0x00000002|write
core_segment_flag|0x00000004|execute
core_segment_flag_known_mask=0x00000007
core_segment_flag_allowed_values=0x00000001,0x00000003,0x00000005
core_segment_flag_rule=R-or-RW-or-RX-only,zero+W-only+X-only+WX+unknown-reject
core_segment_file_offset_base=absolute-from-AlphaCoreHeaderV0-byte-zero
core_segment_congruence=virtual_address-mod-4096-equals-file_offset-mod-4096
core_segment_table_range=128..128+segment_count*48,checked
core_segment_file_ranges=inside-total-bytes,pairwise-disjoint,no-header-or-table-overlap
core_unowned_bytes=zero
core_total_bytes_rule=exact-end-of-last-owned-or-zero-padding-byte,no-trailing-unframed-bytes
core_artifact_identity_zero_range=AlphaCoreHeaderV0.bytes[48..80)
core_artifact_identity_preimage=exact-AlphaCoreHeaderV0.total_bytes-byte-artifact-with-only-bytes-48-through-79-replaced-by-zero
core_artifact_identity_value=ADR-0028-role-4-framing-over-core_artifact_identity_preimage
core_artifact_identity_store=write-result-to-bytes-48-through-79-after-computation
core_source_sha256=SHA-256-over-final-artifact-bytes-with-stored-artifact-identity
core_contract_identity_rule=bytes-80-through-111-exact-reviewed-alpha-core-bootstrap-contract-SHA256,included-unchanged-in-artifact-identity-preimage
segment_rule=checked-contained,canonical-lower-half,sorted-virtual,pairwise-disjoint,each-memory-within-segment-ceiling,aggregate-mapped+BSS-within-ceilings,no-WX,entry-in-exactly-one-RX
mapping_rule=allocate-RW+NX,copy,zero-BSS,remove-write,TLB-flush,map-RX,no-writable-alias
capability|0|component-source|read+map-read|exact-source-role-2|nondelegable-at-bootstrap
capability|1|system-state-selector|create-service-use-only|slot-0|opaque
capability|2|preserved-state-selector|create-service-use-only|slot-1|opaque
capability_table_rule=exact-count+positions+rights,no-boot-volume,no-block-device,no-bus,no-DMA,no-PCI,no-AHCI,no-state-read,no-redeem-token
thread_start_rule=only-after-three-capabilities-installed+all-mappings-final+all-identities-pass
failure_rule=global-alpha-validation-v0,tear-down-fresh-address-space,empty-external-effect-log
