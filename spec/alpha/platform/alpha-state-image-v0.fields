schema=rar-alpha-state-image-v0
status=experimental-pending-review
byte_order=little-endian
parser_owner=matching-state-service-only
role_set=system-state,preserved-state
header_bytes=128
object_record_bytes=96
maximum_total_bytes=8388608
maximum_objects=1024
maximum_name_bytes=65536
wire_field|AlphaStateHeaderV0|0|magic|bytes:8|RARSTATE
wire_field|AlphaStateHeaderV0|8|major|u16|0
wire_field|AlphaStateHeaderV0|10|minor|u16|0
wire_field|AlphaStateHeaderV0|12|role|u16|1-or-2
wire_field|AlphaStateHeaderV0|14|header_bytes|u16|128
wire_field|AlphaStateHeaderV0|16|total_bytes|u64|computed
wire_field|AlphaStateHeaderV0|24|object_table_offset|u64|128
wire_field|AlphaStateHeaderV0|32|object_count|u32|0..1024
wire_field|AlphaStateHeaderV0|36|object_record_bytes|u32|96
wire_field|AlphaStateHeaderV0|40|name_table_offset|u64|aligned-8
wire_field|AlphaStateHeaderV0|48|name_table_bytes|u64|0..65536
wire_field|AlphaStateHeaderV0|56|payload_table_offset|u64|page-aligned
wire_field|AlphaStateHeaderV0|64|payload_table_bytes|u64|bounded
wire_field|AlphaStateHeaderV0|72|source_identity|bytes:32|role-domain+exact-bytes-field-zero-during-hash
wire_field|AlphaStateHeaderV0|104|flags|u32|zero
wire_field|AlphaStateHeaderV0|108|reserved|bytes:20|zero
wire_field|AlphaStateObjectV0|0|object_id|u64|1..max
wire_field|AlphaStateObjectV0|8|parent_id|u64|zero-for-root-or-existing-directory
wire_field|AlphaStateObjectV0|16|kind|u16|1-or-2
wire_field|AlphaStateObjectV0|18|encoding|u16|0-or-1
wire_field|AlphaStateObjectV0|20|flags|u32|zero
wire_field|AlphaStateObjectV0|24|name_offset|u64|within-name-table
wire_field|AlphaStateObjectV0|32|name_bytes|u32|1..255
wire_field|AlphaStateObjectV0|36|reserved0|u32|zero
wire_field|AlphaStateObjectV0|40|payload_offset|u64|within-payload-table
wire_field|AlphaStateObjectV0|48|payload_bytes|u64|zero-for-directory
wire_field|AlphaStateObjectV0|56|payload_sha256|bytes:32|zero-for-directory-or-exact-blob
wire_field|AlphaStateObjectV0|88|reserved1|bytes:8|zero
state_role|0x0001|system-state
state_role|0x0002|preserved-state
state_encoding|0x0000|none
state_encoding|0x0001|raw-bytes
state_encoding_known_values=0x0000,0x0001
state_directory_encoding=0x0000
state_blob_encoding=0x0001
object_kind|1|directory|encoding:none,payload-bytes:0,payload-digest:zero
object_kind|2|blob|encoding:raw-bytes,payload-bounded,digest-required
name_encoding=ASCII-lowercase-digit-dot-hyphen-underscore,1..255,no-dot-or-dot-dot,no-NUL
state_name_offset_base=relative-to-AlphaStateHeaderV0.name_table_offset
state_payload_offset_base=relative-to-AlphaStateHeaderV0.payload_table_offset
state_directory_payload_offset=0
state_directory_payload_bytes=0
state_directory_payload_sha256=32-zero-bytes
state_name_storage=exact-name-bytes,no-NUL+length-prefix+terminator
state_name_table_ownership=object-order-concatenation,no-gap+alias+trailing-unowned-byte
state_payload_table_ownership=blob-object-order-concatenation,no-gap+alias+trailing-unowned-byte
state_alignment_padding=zero
state_total_bytes_rule=exact-end-of-final-owned-table-or-required-zero-padding,no-trailing-unframed-bytes
object_order=object-id-ascending,unique-id,exactly-one-root-directory-id-1,parent-before-child,sibling-name-unique
table_order=header,object-table,name-table,zero-padding,payload-table,zero-padding
overlap_rule=tables-pairwise-disjoint,object-name-ranges-exactly-owned,payload-ranges-pairwise-disjoint,no-immutable-mutable-alias
source_identity_rule=distinct-role-domain+this-contract-identity+exact-source-bytes-with-identity-field-zero
state_source_identity_zero_range=AlphaStateHeaderV0.bytes[72..104)
state_source_identity_preimage=exact-AlphaStateHeaderV0.total_bytes-byte-state-image-with-only-bytes-72-through-103-zero
system_state_source_identity_value=ADR-0028-role-8-framing-over-state_source_identity_preimage
preserved_state_source_identity_value=ADR-0028-role-9-framing-over-state_source_identity_preimage
state_source_identity_store=write-result-to-bytes-72-through-103-after-computation
state_outer_source_sha256=SHA-256-over-final-state-image-with-stored-source-identity
state_blob_payload_sha256=SHA-256-over-exact-blob-payload-bytes,no-zeroing
system_role=1,service-role:system-state-service,mutable-region:system-only
preserved_role=2,service-role:preserved-state-service,mutable-region:preserved-only
positive_preserved_fixture=one-root-directory+one-blob-name:data,payload-exact-hex:616263,payload-exact-ASCII:abc
mutable_import_rule=allocate-fresh-role-owned-region,copy-after-complete-validation,source-remains-immutable-read-only
reconstruction_rule=system-source-read+fresh-system-destination-write,no-preserved-write,preserved-runtime-read-only-during-reconstruction
persistence_rule=no-FAT-writeback,no-shutdown-persistence,no-production-filesystem,no-owner-data
failure_rule=global-alpha-validation-v0,discard-fresh-unpublished-destination,empty-external-effect-log,source-retained
