schema=rar-alpha-identities-v0
status=experimental-pending-review
algorithm=SHA-256
byte_order=little-endian
framing=fixed-domain-32,u16-version,u16-role,u32-contract-bytes,contract-bytes,u64-artifact-bytes,artifact-bytes
framing_field|0|domain|bytes:32|ASCII+NUL-right-padding
framing_field|32|version|u16|0
framing_field|34|role|u16|exact-role-row
framing_field|36|contract_bytes|u32|32
framing_field|40|contract_identity|bytes:32|exact-row-literal
framing_field|72|artifact_bytes|u64|exact-source-length
framing_field|80|artifact|bytes:artifact_bytes|exact-immutable-source
self_identity_rule=identity-field-never-in-own-preimage
domain_padding=ASCII-domain,NUL-pad-right-to-32,no-terminator-if-exactly-32
version=0
role|1|root|RAR-ALPHA-ROOT-IDENTITY-V0
role|2|recovery|RAR-ALPHA-RECOVERY-ID-V0
role|3|nucleus|RAR-ALPHA-NUCLEUS-ID-V0
role|4|core-bootstrap|RAR-ALPHA-CORE-BOOT-ID-V0
role|5|component|RAR-ALPHA-COMPONENT-ID-V0
role|6|system-state-service|RAR-ALPHA-SYSTEM-SVC-ID-V0
role|7|preserved-state-service|RAR-ALPHA-PRESERVE-SVC-ID-V0
role|8|system-state-source|RAR-ALPHA-SYSTEM-STATE-SRC-V0
role|9|preserved-state-source|RAR-ALPHA-PRESERVE-STATE-SRC-V0
role|10|component-bundle-source|RAR-ALPHA-BUNDLE-SOURCE-ID-V0
contract_identity=SHA-256-over-exact-canonical-contract-file-bytes
