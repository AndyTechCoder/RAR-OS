service_contract_literal_rule=distinct-fixed-private-Alpha-executable-contract-domains,not-display-names,reviewed-literals-only
artifact_identity=SHA-256-over-framed-preimage
root_identity_authority=descriptive-only,never-expected-literal,never-recipient-selection,never-gate
recovery_source=exact-retained-RECOVERY.ELF-file-bytes
recovery_preload_verifier=Root
recovery_preload_rule=computed-equals-reviewed-literal-before-ELF-parse-map-load
recovery_postentry_verifier=Recovery
recovery_postentry_rule=recompute-retained-file-bytes-equals-transported+compiled-literal,then-retire-file-source-before-Nucleus
nucleus_source=exact-NUCLEUS.ELF-file-bytes
nucleus_verifier=Recovery-preload-and-Nucleus-compiled-literal-compare
core_bootstrap_source=exact-CORE.IMG-bytes
core_bootstrap_verifier=Nucleus-bounded-parser
component_verifier=Core-loader-only
state_service_preimage=distinct-role+exact-executable-contract-identity+exact-executable-payload-bytes
state_service_verifier=Nucleus-hashes-capability-contained-fixed-slice,no-bundle-parse,no-service-choice
state_service_comparison=computed-equals-compiled-literal-equals-outer-transported
build_order=system-state-service,preserved-state-service,literal-table,Nucleus,final-envelope,final-image
build_order_rule=earlier-output-immutable-before-later-input,cycle-reject,caller-supplied-identity-reject
identity_flow|root|image-packer+inspector|BOOTX64.EFI-file|closure-record|evidence-only|never
identity_flow|recovery|image-packer+Root|RECOVERY.ELF-file|RootRecoveryHeaderV0|Root+Recovery+Nucleus-literal|after-Recovery-secondary-check
identity_flow|nucleus|image-packer+Root|NUCLEUS.ELF-file|RootRecoveryHeaderV0|Recovery+Nucleus-literal|after-Nucleus-map
identity_flow|core-bootstrap|image-packer+Root|CORE.IMG|AlphaSourceRecordV0|Nucleus-literal|after-Core-start
identity_flow|component-bundle-source|bundle-packer+Root|COMPONEN.RAC|AlphaSourceRecordV0|Recovery+Core-loader|after-bundle-parse
identity_flow|component|bundle-packer+Core|entry-contract+payload|AlphaComponentEntryV0|Core|after-component-map-or-reject
identity_flow|system-state-service|service-build+Nucleus|service-contract+payload|literal-table+outer-record|Nucleus|slot-terminal-revoke
identity_flow|preserved-state-service|service-build+Nucleus|service-contract+payload|literal-table+outer-record|Nucleus|slot-terminal-revoke
identity_flow|system-state-source|state-packer+Root|SYSTEM.RAS|AlphaSourceRecordV0+AlphaStateHeaderV0|Nucleus+system-state-service|after-system-slot-import
identity_flow|preserved-state-source|state-packer+Root|PRESERVE.RAP|AlphaSourceRecordV0+AlphaStateHeaderV0|Nucleus+preserved-state-service|after-preserved-slot-import
mismatch_rule=reject-at-global-precedence,before-map+thread+slot-attach,empty-effect-log
vector_rule=fixture-records-exact-preimage-hex+expected-SHA256,packer-and-independent-inspector-recompute-both
replacement_rule=new-domain+new-version+reviewed-migration,old-domain-reject-never-reinterpret
