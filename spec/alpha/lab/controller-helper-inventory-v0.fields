schema=rar-alpha-controller-helper-inventory-schema-v0
status=experimental-inactive
instance_schema=rar-alpha-controller-helper-inventory-v0
state_values=blocked,ready
decision_values=adr-0024-alternative-a,adr-0024-alternative-b,adr-0024-alternative-c,unavailable
topology_values=runner-closure,repository-binary,controller-tool-image,unavailable
required_field|schema|literal:rar-alpha-controller-helper-inventory-v0
required_field|state|enum:blocked,ready
required_field|decision|decision-or-unavailable
required_field|topology|topology-or-unavailable
required_field|host_target|literal:x86_64-unknown-linux-gnu
required_field|builder_inventory_sha256|sha256-or-unavailable
required_field|compiler_closure_manifest_sha256|sha256-or-unavailable
required_field|compiler_path|canonical-builder-path-or-unavailable
required_field|compiler_sha256|sha256-or-unavailable
required_field|source_tree_sha256|sha256-or-unavailable
required_field|build_plan_sha256|sha256-or-unavailable
required_field|golden_vector_sha256|sha256-or-unavailable
required_field|binary_sha256|sha256-or-unavailable
required_field|binary_bytes|positive-integer-or-unavailable
required_field|build_evidence_sha256|sha256-or-unavailable
required_field|test_evidence_sha256|sha256-or-unavailable
required_field|dependency_count|literal:0
required_field|target_linked|literal:false
blocked_rule=decision+topology+all-builder+compiler+source+binary+evidence-identities-unavailable
ready_rule=accepted-adr-0024-decision,matching-topology,all-identities-lowercase-nonzero-sha256,binary-bytes-1..16777216,two-build-evidence-accepted,test-evidence-accepted
decision_mapping|adr-0024-alternative-a|runner-closure
decision_mapping|adr-0024-alternative-b|repository-binary
decision_mapping|adr-0024-alternative-c|controller-tool-image
source_rule=trusted-default-branch-controller-handoff-tree-only,no-untrusted-target-source,no-owner-data,no-credentials
build_rule=two-fresh-bounded-network-disabled-builds,same-reviewed-inputs,byte-identical-output
test_rule=isolated-linux-only,golden+sha256+manifest+descriptor-negative-cases,no-Mac-execution
authority_rule=helper-filesystem-descriptors-only,no-process-spawn,no-network,no-container-api,no-cloud-api,no-credential,no-GitHub-write,no-target-launch
shipping_rule=host-controller-only,never-target-linked,never-target-shipped
activation_rule=inventory+compiler-closure+source+binary+build-evidence+test-evidence-reviewed-and-bound-before-v2-controller-ready
replacement_rule=experimental-host-inventory,topology-replaceable-after-reviewed-ADR,no-target-format-impact
