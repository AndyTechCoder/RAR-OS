schema=rar-alpha-controller-helper-runtime-v0
status=experimental-complete-source-only-inactive
authority=trusted-outer-controller+already-open-descriptors+nonreusable-process-handle
execution_authority=none-until-H1C
descriptor_count=6
descriptor|3|helper-executable|regular,owner-controller,mode-0500,nlink-1,O_RDONLY+O_NOFOLLOW+O_CLOEXEC,exact-binary
descriptor|4|journal-root|directory,owner-controller,mode-0700,O_RDONLY+O_DIRECTORY+O_NOFOLLOW+O_CLOEXEC
descriptor|5|source-root|directory,owner-controller,mode-0700,O_RDONLY+O_DIRECTORY+O_NOFOLLOW+O_CLOEXEC
descriptor|6|destination-root|directory,owner-controller,mode-0700,O_RDONLY+O_DIRECTORY+O_NOFOLLOW+O_CLOEXEC
descriptor|7|manifest-root|directory,owner-controller,mode-0700,O_RDONLY+O_DIRECTORY+O_NOFOLLOW+O_CLOEXEC
descriptor|8|control-channel|full-duplex-seqpacket,controller-created,CLOEXEC-cleared-only-for-child
descriptor_rule=all-other-descriptors-closed-before-exec,descriptor-numbers+purposes-exact,no-ambient-root+cwd+path+proc-fd-reopen-authority
basename_rule=ASCII-lowercase+digits+dot+hyphen,1..64-bytes,no-slash+NUL+dot+dotdot+prefix-dot
creation_rule=descriptor-relative,O_NOFOLLOW+O_EXCL+O_CLOEXEC,regular-mode-0600-or-directory-mode-0700,never-replace
identity_rule=uid+gid+mode+nlink+device+inode+size-recorded-on-open,rechecked-same-descriptor-before+after-use,nonzero-device+inode,no-alias
exec_rule=execveat-helper-fd-empty-path+AT_EMPTY_PATH,argv-exact,empty-environment,no-shell+PATH+interpreter+url+credential
process_rule=controller-owned-pidfd-or-equivalent-nonreusable-handle,bare-PID-never-authority,handle-closed-after-reap
start_protocol=durable-start-authorized,spawn,child-stop-before-helper-code,parent-validates-handle+descriptors,ack,continue,bounded
watchdog_rule=CLOCK_MONOTONIC,1..1200-seconds,deadline-fixed-before-continue,no-extension,termination-grace-1..30-seconds,total-1..3600-seconds
stop_rule=cancel-or-timeout-through-owned-handle,TERM,wait-bounded,KILL-if-needed,wait+reap-required,ambiguous-exit-blocked
exit_rule=controller-observed-wait-status-only,signal+core+unknown-encoding-reject,zero-is-not-commit-authority
journal_rule=hash-chained-exclusive-transitions,write-exact,same-FD-parse+identity-recheck,fdatasync,close,journal-root-fsync
transition_order=prepared,start-authorized,running-observed,exit-observed,outputs-validated,committed-or-recovery-required,recovery-inventory-durable,discarded-or-blocked
restart_rule=new-controller-session-never-resumes-normal-work,takeover-requires-matching-open-descriptors+stopped-helper+validated-chain,recovery-only
recovery_rule=source-never-deleted,exclusive-attempt-roots,bounded-exact-enumeration,inventory-durable-before-delete,identity-match-before-each-delete
cleanup_rule=destination+manifest-entries-only,never-root-or-source,changed+aliased+uncertain-entry-blocks,empty-roots-retained
uncertainty_rule=uncertain-commit+sync+cleanup+exit+identity+chain-is-blocked,no-next-effect
attempt_ceiling=3-normal-attempts+3-recovery-sessions,fourth-is-durable-blocked,no-reuse+loop
publication_rule=no-lock+inventory+profile+gate+readiness+GitHub-write
target_rule=no-compiler+linker+helper+target+container+VM+emulator+firmware+network+credential
local_rule=text+hash+structure-check-only;never-execute-on-Mac
