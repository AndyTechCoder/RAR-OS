schema=rar-alpha-crypto-reference-inventory-schema-v2
status=experimental-inactive
instance_schema=rar-alpha-crypto-reference-inventory-v2
role=reference-only
required_field|schema|literal:rar-alpha-crypto-reference-inventory-v2
required_field|state|enum:blocked,ready
required_field|reference_oci_image|oci-digest-or-unavailable
required_field|reference_1_name|literal:OpenSSL
required_field|reference_1_version|literal:3.0.13
required_field|reference_1_license|literal:Apache-2.0
required_field|reference_1_source_sha256|sha256-or-unavailable
required_field|reference_1_path|reference-root-path-or-unavailable
required_field|reference_1_sha256|sha256-or-unavailable
required_field|reference_2_name|literal:libsodium
required_field|reference_2_version|literal:1.0.19
required_field|reference_2_license|literal:ISC
required_field|reference_2_source_sha256|sha256-or-unavailable
required_field|reference_2_path|reference-root-path-or-unavailable
required_field|reference_2_sha256|sha256-or-unavailable
required_field|harness_path|reference-root-path-or-unavailable
required_field|harness_sha256|sha256-or-unavailable
required_field|comparison_schema_sha256|sha256-or-unavailable
path_root=/opt/rar-reference
blocked_rule=all-executable-and-image-identities-unavailable
ready_rule=all-source,binary,harness,schema,image-identities-pinned
independence_rule=different-upstreams,different-licenses,no-shared-target-code
boundary_rule=no-source,no-target-image,no-launch-authority,no-network,no-credentials
target_rule=never-linked,never-shipped,never-runtime-loaded

