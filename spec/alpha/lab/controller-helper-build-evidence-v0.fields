schema=rar-alpha-controller-helper-build-evidence-v0
status=experimental-host-only
encoding=ascii-key-value,LF-only,no-NUL,no-blank-line,exactly-19-lines,maximum-4096-bytes
fields=schema,decision,topology,controller_sha,source_tree_sha256,build_plan_sha256,golden_vector_sha256,builder_inventory_sha256,compiler_closure_manifest_sha256,compiler_sha256,build_1_sha256,build_2_sha256,final_binary_sha256,binary_bytes,test_evidence_sha256,network,build_count,reproducible,status
canonical_rule=exact-order,one-terminal-LF,no-CR,no-leading-zero-decimal,lowercase-digests,no-extra-byte
decision_rule=accepted-adr-0024-alternative-and-matching-topology
identity_rule=controller-sha-40-lowercase-hex,all-sha256-fields-64-lowercase-nonzero-hex
binary_rule=build-1-sha256-equals-build-2-sha256-equals-final-binary-sha256,binary-bytes-1..16777216
execution_rule=build-count-2,reproducible-yes,network-none,status-accepted
freshness_rule=two-distinct-fresh-bounded-build-roots,no-reused-output,no-preexisting-binary
input_rule=same-controller-sha+source-tree+build-plan+golden-vector+builder-inventory+compiler-closure+compiler
test_rule=test-evidence-binds-final-binary+source+golden-vector,all-reviewed-cases-pass,real-exit-status-zero
retention_rule=exact-builder+compiler+source+plan+golden+binary+test+log-identities-retained
failure_rule=missing,extra,duplicate,reordered,malformed,unapproved-decision,topology-mismatch,zero-digest,build-mismatch,oversize,networked,nonfresh,test-failure,or-nonzero-status-rejects
replacement_rule=experimental-host-evidence,not-target-format,topology-independent-fields
