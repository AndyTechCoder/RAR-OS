schema=rar-alpha-controller-helper-closure-verification-schema-v0
status=experimental-inactive-source-only
purpose=mechanically-verify-a-retained-candidate-compiler-closure-exact-set-without-reviewing-provenance-or-activating-anything
execution_authority=none
candidate_state=absent,no-cloud-run-authorized,no-retained-candidate-manifest-or-receipt
input_boundary=exact-controller-owned-read-only-/evidence-mount,no-concurrent-writer,exactly-controller-helper-closure.sha256+controller-helper-closure.receipt
tool_pin_boundary=exact-controller-owned-read-only-/trusted/controller-helper-closure-verifier-tools.v0,whole-file-sha256-must-equal-separately-reviewed-controller-bound-value
tool_pin_encoding=ASCII-key-value,LF-only,no-NUL,no-blank-line,exactly-8-lines,maximum-2048-bytes,reconstruct-canonical-records-and-byte-compare-before-use
tool_pin_field_order=schema,find_sha256,sort_sha256,wc_sha256,stat_sha256,cmp_sha256,id_sha256,status
tool_pin_literal_values=schema:rar-alpha-controller-helper-closure-verifier-tools-v0,status:reviewed-for-candidate-verification-only
tool_pin_digest_values=find_sha256+sort_sha256+wc_sha256+stat_sha256+cmp_sha256+id_sha256:lowercase-nonzero-sha256
verifier_pin_boundary=RAR_REVIEWED_VERIFIER_SHA256-is-a-separately-reviewed-controller-bound-lowercase-nonzero-sha256,verifier-bytes-must-match-before-candidate-processing,and-stat-identity+sha256-must-remain-identical-through-completion
output_boundary=exact-controller-owned-writable-/verification-mount,no-concurrent-writer,controller-helper-closure-verification.receipt-must-not-preexist,receipt-is-fully-built+bounded+validated-in-private-scratch-before-exclusive-final-copy,valid-final-receipt-is-last-effect
scratch_boundary=private-empty-tmpfs-/tmp/rar-controller-helper-closure-verification,created-exclusively,no-checkout-or-trust-state-write
closure_root=/usr/local/rustup/toolchains/1.95.0-x86_64-unknown-linux-gnu
manifest_contract=identical-to-rar-alpha-controller-helper-closure-observation-schema-v0-manifest_encoding+manifest_record+manifest_path_alphabet+manifest_path_rejections+manifest_order
observation_receipt_contract=identical-to-rar-alpha-controller-helper-closure-observation-schema-v0-receipt_encoding+receipt_field_order+receipt_value_domains,reconstruct-canonical-records-and-byte-compare-before-acceptance
input_binding=receipt-manifest-sha256+entries+bytes-equal-actual-manifest,controller-sha-equals-source-sha-equals-external-exact-main,observer-generator-sha256-equals-reviewed-observer-source
input_identity=regular,not-symlink,one-link,controller-uid-owned,distinct-device+inode,pre+post-stat-and-sha256-identical,no-extra-/evidence-entry,evidence+verification-directories-controller-uid-owned
exact_set_algorithm=independently-enumerate-all-closure-paths-without-xdev,reject-any-path-outside-exact-ASCII-alphabet-before-line-processing,reject-non-directory/non-regular+cross-device+regular-hardlink+duplicate-device-inode+nested-mount-or-bind,LC_ALL-C-sort,hash-every-regular-file,regenerate-canonical-manifest,byte-compare-candidate
mutation_rule=external-controller-enforces-immutable-read-only-single-process-closure-mount,verifier-repeats-complete-topology+identity+manifest-pass,pre+post-passes+proc-self-mountinfo-must-be-byte-identical
topology_snapshot=every-root+descendant-path,type,device,inode,link-count,size,mode,mtime,ctime;LC_ALL-C-sorted
resource_bounds=closure-descendants-1..65536,topology-lines-maximum-1024-bytes,each-scratch-list-or-snapshot-maximum-16777216-bytes,total-tmpfs+CPU+wall-time-controller-bounded
tool_rule=/usr/bin/dash+/usr/bin/sha256sum+/usr/bin/mkdir-have-preverified-lock-identities;find+sort+wc+stat+cmp+id-must-match-separately-reviewed-tool-pin-file-before-use
context_rule=canonical-main-push-only,controller-sha-equals-source-sha-equals-github-sha,canonical-repository,attested-linux-x64-runner,exact-pinned-OCI-image
trust_rule=environment-values-are-context-selectors-not-attestation,external-controller-must-enforce-image+mount+revision+credential+resource+network+process-isolation
forbidden_operations=rustc,cargo,linker,helper,repository-test,target-tool,package-manager,network-client,cloud-client,credential-read,container-api,GitHub-write,checkout-write,evidence-write,closure-write,lock-write,inventory-write,profile-write,gate-report-write
receipt_encoding=ASCII-key-value,LF-only,no-NUL,no-blank-line,exactly-31-lines,maximum-8192-bytes
receipt_field_order=schema,status,controller_sha,source_sha,repository,run_id,run_attempt,runner_os,runner_image_version,oci_image,closure_root,verifier_sha256,observer_sha256,tool_pins_sha256,find_sha256,sort_sha256,wc_sha256,stat_sha256,cmp_sha256,id_sha256,candidate_receipt_sha256,candidate_manifest_sha256,recomputed_manifest_sha256,manifest_entries,manifest_bytes,topology_sha256,second_pass_sha256,helper_compiled,helper_executed,target_compiled,readiness
receipt_status=candidate-exact-set-verified-not-reviewed-not-ready
receipt_literal_values=schema:rar-alpha-controller-helper-closure-verification-v0,status:candidate-exact-set-verified-not-reviewed-not-ready,repository:AndyTechCoder/RAR-OS,runner_os:ubuntu24,oci_image:sha256:f49565f188ee00bc2a18dd418183f2c5f23ef7d6e691890517ed341a598f67c3,closure_root:/usr/local/rustup/toolchains/1.95.0-x86_64-unknown-linux-gnu
receipt_revision_values=controller_sha+source_sha:identical-lowercase-hex-exactly-40-bytes-and-equal-external-exact-main
receipt_runner_image_version=ASCII-digits-and-dots-1..64-bytes,starts-and-ends-with-digit,no-adjacent-dots
receipt_digest_values=verifier_sha256+observer_sha256+tool_pins_sha256+find_sha256+sort_sha256+wc_sha256+stat_sha256+cmp_sha256+id_sha256+candidate_receipt_sha256+candidate_manifest_sha256+recomputed_manifest_sha256+topology_sha256+second_pass_sha256:lowercase-nonzero-sha256
receipt_decimal_values=run_id+run_attempt+manifest_entries+manifest_bytes:canonical-positive-decimal-1..20-digits,no-leading-zero
receipt_false_fields=helper_compiled:false,helper_executed:false,target_compiled:false,readiness:false
verified_definition=mechanical-candidate-bytes-equal-two-complete-stable-closure-passes-only,not-provenance,license,authenticated-acquisition,compiler-trust,helper-build,test,activation,or-readiness
consumer_rule=no-controller,profile,inventory,build,test,launch,acceptance,signing,or-release-consumer-may-treat-this-receipt-as-ready-input
generator_binding=shebang-and-future-invocation-must-use-/usr/bin/dash,executing-$0-must-equal-/workspace/tools/ci/verify-controller-helper-closure-candidate.sh,regular,not-symlink,and-match-controller-bound-RAR_REVIEWED_VERIFIER_SHA256
activation_rule=verification-never-updates-observer-output,tool-lock,helper-inventory,lab-profile,controller,gate-report,or-readiness
followup_rule=separate-review-must-pin-verifier-tools+candidate-bytes+verification-receipt+licenses+provenance+authenticated-acquisition+runtime-evidence-before-helper-build-or-test
validation_rule=current-checks-are-source-hash+syntax+invariant+nonwiring-only,verifier-is-never-invoked,runtime-negative+fault+mutation+confinement-tests-required-before-any-wiring
failure_rule=wrong-context,wrong-identity,unreviewed-tool-pin,unexpected-input,alias,mutation,unsafe-path,unexpected-topology,cross-device,hardlink,missing-or-extra-file,grammar,order,digest,count,size,comparison,output-collision,or-bound-failure-rejects-with-no-success-receipt
replacement_rule=experimental-host-verification-contract,not-target-format,not-public-evidence,not-persistent-RAR-data,replaceable-before-activation
