role_rule|build|source:read-only,compiler:required,linker:required,reference:forbidden,qemu:forbidden,firmware:forbidden,network:none,credentials:none
role_rule|reference|source:forbidden,target-image:forbidden,transcript:read-only,references:required,compiler:forbidden,linker:forbidden,qemu:forbidden,firmware:forbidden,network:none,credentials:none
role_rule|launch|source:forbidden,target-image:read-only,references:forbidden,compiler:forbidden,linker:forbidden,qemu:required,firmware:required,network:none,credentials:none
runtime_mount_rule|build|/workspace:source:read-only,/output/artifact:artifact-only:read-write-noexec-nodev-nosuid:64MiB,/output/transcript:transcript-only:read-write-noexec-nodev-nosuid:1MiB
runtime_mount_rule|reference|/input/transcript:transcript-one-file:read-only-noexec-nodev-nosuid,/output/reference:comparison-evidence-only:read-write-noexec-nodev-nosuid:1MiB
runtime_mount_rule|launch|/artifact/rar-os-alpha.img:artifact-one-file:read-only-noexec-nodev-nosuid,/profile/x86_64-q35-v1.profile:machine-profile-one-file:read-only-noexec-nodev-nosuid,/controller:trusted-controller:read-only-noexec-nodev-nosuid,/evidence:launch-evidence-only:read-write-noexec-nodev-nosuid:64MiB,/control/to-host:signal-only:read-write-noexec-nodev-nosuid:4KiB,/control/to-launch:signal-only:read-only-noexec-nodev-nosuid:4KiB
