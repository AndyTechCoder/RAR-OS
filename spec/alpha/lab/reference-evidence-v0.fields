schema=rar-alpha-reference-evidence-schema-v0
status=experimental-replaceable
byte_order=little-endian
comparison_magic=52:41:52:52:45:46:45:56
comparison_version_major=0
comparison_version_minor=0
comparison_header_bytes=128
comparison_record_bytes=256
comparison_maximum_bytes=1048576
comparison_maximum_records=512
comparison_flags=none
comparison_total_bytes_rule=exactly-128-plus-record-count-times-256,checked-u32,maximum-1048576
comparison_eof_rule=physical-file-bytes-equals-total-bytes,no-trailing-data,no-padding-after-final-record
comparison_zero_rule=header-flags-zero,header-reserved-zero,record-flags-zero,record-reserved-zero,unused-output-tail-zero
wire_field|ReferenceEvidenceHeaderV0|0|magic|bytes:8
wire_field|ReferenceEvidenceHeaderV0|8|major|u16
wire_field|ReferenceEvidenceHeaderV0|10|minor|u16
wire_field|ReferenceEvidenceHeaderV0|12|header_bytes|u16
wire_field|ReferenceEvidenceHeaderV0|14|record_bytes|u16
wire_field|ReferenceEvidenceHeaderV0|16|total_bytes|u32
wire_field|ReferenceEvidenceHeaderV0|20|record_count|u32
wire_field|ReferenceEvidenceHeaderV0|24|flags|u32
wire_field|ReferenceEvidenceHeaderV0|28|reserved0|u32
wire_field|ReferenceEvidenceHeaderV0|32|transcript_sha256|bytes:32
wire_field|ReferenceEvidenceHeaderV0|64|reference_inventory_sha256|bytes:32
wire_field|ReferenceEvidenceHeaderV0|96|harness_sha256|bytes:32
wire_field|ReferenceEvidenceRecordV0|0|case_id|u32
wire_field|ReferenceEvidenceRecordV0|4|operation|u16
wire_field|ReferenceEvidenceRecordV0|6|target_status|u16
wire_field|ReferenceEvidenceRecordV0|8|reference_1_status|u16
wire_field|ReferenceEvidenceRecordV0|10|reference_2_status|u16
wire_field|ReferenceEvidenceRecordV0|12|output_bytes|u16
wire_field|ReferenceEvidenceRecordV0|14|flags|u16
wire_field|ReferenceEvidenceRecordV0|16|reference_1_output|bytes:64
wire_field|ReferenceEvidenceRecordV0|80|reference_2_output|bytes:64
wire_field|ReferenceEvidenceRecordV0|144|reference_1_output_sha256|bytes:32
wire_field|ReferenceEvidenceRecordV0|176|reference_2_output_sha256|bytes:32
wire_field|ReferenceEvidenceRecordV0|208|target_output_sha256|bytes:32
wire_field|ReferenceEvidenceRecordV0|240|reserved0|bytes:16
comparison_status_values=0:ok,1:rejected
comparison_rule=one-record-per-transcript-record,same-count,same-strict-case-order,same-operation,same-target-status,output-bytes-from-operation
comparison_output_rule=unused-reference-output-tail-zero,sha256-covers-exact-output-bytes,both-reference-status-and-output-equal-target,both-reference-outputs-equal-each-other
comparison_failure_rule=any-header-record-range-order-status-length-hash-output-or-transcript-mismatch-rejects-whole-evidence
verdict_encoding=ascii-key-value,LF-only,no-NUL,no-blank-line,exactly-13-lines,maximum-2048-bytes
verdict_schema=rar-alpha-reference-verdict-v0
verdict_fields=schema,status,probe,controller_sha256,source_sha256,transcript_sha256,reference_inventory_sha256,comparison_evidence_sha256,record_count,reference_1_result,reference_2_result,target_result,reason
verdict_status_values=accepted,not-required
verdict_accepted_rule=probe-milestone-f-or-g,all-five-digests-lowercase-nonzero-sha256,record-count-1..512,both-reference-results-match,target-result-match,reason-all-three-match
verdict_not_required_rule=probe-milestone-a-through-e,controller-source-transcript-digests-lowercase-nonzero-sha256,inventory-and-evidence-digests-all-zero,record-count-0,both-reference-results-not-run,target-result-not-evaluated,reason-probe-does-not-require-reference
verdict_owner=trusted-controller-only
verdict_binding=probe+controller-sha+source-sha+transcript-sha+reference-inventory-sha+comparison-evidence-sha+record-count
verdict_context_rule=controller-hashes-actual-controller+source+frozen-transcript+inventory+comparison-evidence,parses-comparison-evidence-against-transcript+inventory+harness,requires-exact-expected-probe-before-accepting-verdict
verdict_canonical_rule=record-count-decimal-is-zero-or-nonzero-without-leading-zero,exactly-one-terminal-LF,no-CR,no-trailing-byte
verdict_failure_rule=missing,extra,duplicate,reordered,malformed,unsupported,status-probe-mismatch,stale-or-swapped-context,zero-required-digest,nonzero-forbidden-digest,result-or-reason-mismatch-reject
