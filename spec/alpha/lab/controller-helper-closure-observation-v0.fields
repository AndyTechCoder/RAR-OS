schema=rar-alpha-controller-helper-closure-observation-schema-v0
status=experimental-inactive-source-only
purpose=observe-a-candidate-complete-linux-rust-closure-for-separate-review-without-compiling-or-activating-anything
execution_authority=none
output_boundary=exact-controller-owned-writable-directory-at-/evidence,not-symlink,only-writable-container-mount,no-concurrent-writer,manifest-and-receipt-must-not-preexist,no-checkout-or-trust-state-write
output_files=/evidence/controller-helper-closure.sha256,/evidence/controller-helper-closure.receipt
manifest_encoding=sha256sum-compatible-ASCII,LF-only,no-CR,no-NUL,one-terminal-LF,maximum-1048576-bytes-enforced-before-each-record-write,maximum-451-bytes-per-line
manifest_record=lowercase-hex-sha256-exactly-64-bytes,two-ASCII-spaces,root-relative-path-1..384-bytes
manifest_path_alphabet=ASCII-uppercase-A-Z,lowercase-a-z,digits-0-9,dot,underscore,slash,plus,colon,hyphen
manifest_path_rejections=empty,absolute,dot,dotdot,dot-prefix,dotdot-prefix,double-slash,interior-dot,interior-dotdot,trailing-dot,trailing-dotdot,duplicate
manifest_order=LC_ALL-C-bytewise-path-order,no-duplicate,no-empty-record
closure_root=/usr/local/rustup/toolchains/1.95.0-x86_64-unknown-linux-gnu
closure_topology=directories-and-regular-files-only,no-symlink,no-device,no-fifo,no-socket,no-cross-device
closure_set_rule=enumerate-every-regular-file,hash-every-enumerated-file,manifest-count-equals-enumeration-count
environment_rule=canonical-main-push-only,controller-sha-equals-source-sha-equals-github-sha,canonical-repository,attested-linux-x64-runner
container_rule=exact-pinned-rust-1.95.0-oci-image,read-only,network-none,nonroot,no-new-privileges,cap-drop-all,bounded-resources,single-observer-process,tmpfs-scratch-only,trusted-controller-read-only-mount,exact-/evidence-controller-output-mount
trust_rule=environment-values-are-context-selectors-not-attestation,external-controller-must-enforce-container+mount+revision+credential-isolation,candidate-output-is-untrusted-until-separate-exact-set-verification
tool_rule=dash+sha256sum+mkdir-identities-preverified,wc+grep-fixed-expected-identities-pending-review,find+sort-identities-observed-for-later-review
forbidden_operations=rustc,cargo,linker,helper,repository-test,target-tool,package-manager,network-client,cloud-client,credential-read,checkout-write,lock-write,inventory-write,profile-write,gate-report-write
receipt_encoding=ascii-key-value,LF-only,no-NUL,no-blank-line,exactly-23-lines,maximum-4096-bytes
receipt_field_order=schema,status,controller_sha,source_sha,repository,ref,event,run_id,run_attempt,runner_os,runner_image_version,oci_image,closure_root,generator_sha256,find_sha256,sort_sha256,manifest_sha256,manifest_entries,manifest_bytes,helper_compiled,helper_executed,target_compiled,readiness
receipt_literal_values=schema:rar-alpha-controller-helper-closure-observation-v0,status:observed-not-reviewed-not-ready,repository:AndyTechCoder/RAR-OS,ref:refs/heads/main,event:push,runner_os:ubuntu24,oci_image:sha256:f49565f188ee00bc2a18dd418183f2c5f23ef7d6e691890517ed341a598f67c3,closure_root:/usr/local/rustup/toolchains/1.95.0-x86_64-unknown-linux-gnu
receipt_revision_values=controller_sha+source_sha:identical-lowercase-hex-exactly-40-bytes
receipt_decimal_values=run_id+run_attempt+manifest_entries+manifest_bytes:canonical-positive-decimal-1..20-digits,no-leading-zero
receipt_runner_image_version=ASCII-digits-and-dots-1..64-bytes,starts-and-ends-with-digit,no-adjacent-dots
receipt_digest_values=generator_sha256+find_sha256+sort_sha256+manifest_sha256:lowercase-hex-exactly-64-bytes
receipt_status=observed-not-reviewed-not-ready
receipt_false_fields=helper_compiled:false,helper_executed:false,target_compiled:false,readiness:false
generator_binding=shebang-and-future-invocation-must-use-/usr/bin/dash,executing-$0-must-equal-/workspace/tools/ci/observe-controller-helper-closure.sh,regular,not-symlink,and-match-reviewed-generator-sha256
retention_rule=candidate-manifest+receipt-must-be-controller-owned-and-sha-bound-if-future-approved-cloud-run-retains-them
activation_rule=observation-never-updates-tool-lock,helper-inventory,lab-profile,controller,gate-report,or-readiness
followup_rule=separate-review-must-pin-observer-tools+candidate-manifest+exact-set-verifier-before-helper-build-or-test
validation_rule=current-checks-are-source-hash+syntax+nonwiring-only,runtime-negative+fault+mutation+confinement-tests-required-before-any-activation
failure_rule=wrong-context,wrong-identity,unexpected-topology,unsafe-path,duplicate,empty,oversized,hash-failure,enumeration-mismatch,output-boundary-mismatch,or-output-collision-rejects-with-no-readiness
replacement_rule=experimental-host-observation-contract,not-target-format,removable-after-reviewed-controller-tool-topology
