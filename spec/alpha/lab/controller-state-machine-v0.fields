skip_rule|reference|A-E|emit-controller-owned-reference-verdict-not-required,no-reference-container-created,continue-at-phase-7
verdict_rule|reference|F-G:accepted-only-after-both-references-match-each-other-and-target-with-real-inventory-and-evidence-digests,A-E:not-required-only-from-trusted-controller-with-zero-inventory-and-evidence-digests,canonical-record-bound-to-probe+controller+source+transcript,phase-8-requires-exactly-one-verdict,retained-set-includes-verdict-and-digest
freshness_rule|build-one-build-two|distinct-fresh-containers,distinct-empty-output-mounts,same-source-digest,same-tool-identities
reproducibility_rule|freeze|artifact-one-equals-artifact-two,transcript-one-equals-transcript-two,compare-size-then-sha256-then-bytes
handoff_rule|all|stop-and-remove-producing-role,open-output-no-follow,validate-type-owner-mode-links-size,copy-to-fresh-controller-file,hash-and-recheck-same-descriptor,unmount-source-before-next-role
role_overlap_rule=at-most-one-role-container-running,controller-never-enters-build-or-reference-filesystem,build-and-reference-never-receive-controller-tree
failure_rule=stop-current-role,remove-current-role,retain-bounded-controller-log,delete-only-task-owned-ephemeral-paths,no-later-phase,no-publication,no-merge,no-signing-acceptance
timeout_rule=per-role-1..1200-seconds,total-controller-1..3600-seconds,no-unbounded-poll
activation_rule=controller-source-merged-main,profile-ready,all-identities-real,all-inventories-verified,two-image-reproduction-evidence,correctness-review,security-review,external-owner-authorized-cloud-run
profile_rule=blocked-instance-validates-and-stops-before-any-effect,ready-instance-requires-all-activation-identities-and-reviews
acceptance_rule=controller+profile+launch+verifier+transcript-bind-exact-v2-digest,v1-or-missing+mismatched+duplicate-identity-rejects
accepted_evidence_rule=phase-8-recomputes-and-binds-fresh-attempt+probe+controller+source+artifact+protocol+profile+tools+outputs+handoff+reference+inventories,any-replay-or-mismatch-rejects
inactive_rule=blocked-profile-means-no-container-command,no-cloud-command,no-network-command,no-credential-read
publication_rule=no-push,no-PR-change,no-merge,no-release,no-deployment
target_rule=cloud-only-never-Mac,artifact-unsigned-until-Milestone-F-evidence,reference-code-never-target-linked
