wire_field|AttemptRootV0|72|reserved1|bytes:56
root_rule=directory,current-controller-owner,mode-0700,nonzero-device+inode,pairwise-nonalias,flags+reserved-zero,no-parent-authority,no-root-directory-unlink
root_table_rule=canonical-order,source-indices-contiguous-1..N,N-in-1..2,exactly-one-destination-at-N+1,exactly-one-manifest-at-N+2,phase-role-source-count-valid
expected_kind=1:artifact,2:transcript,3:comparison-evidence,4:launch-evidence
wire_field|AttemptExpectedEntryV0|0|source_root_index|u16
