wire_field|AttemptActiveHeaderV0|304|active_sha256|bytes:32
wire_field|AttemptActiveHeaderV0|336|reserved1|bytes:176
active_flag=bit-0-helper-unavailable,all-other-bits-zero
attempt_rule=attempt-ordinal-1..3-per-phase,fourth-attempt-durable-blocked,no-loop-or-ordinal-reuse
root_kind=1:source,2:destination,3:manifest
root_flag=all-bits-zero
wire_field|AttemptRootV0|0|root_kind|u16
