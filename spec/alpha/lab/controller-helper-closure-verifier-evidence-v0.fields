schema=rar-alpha-controller-helper-closure-verifier-evidence-v0
status=experimental-complete-source-only-inactive
execution_authority=none-until-C3V
header_fields=schema,controller_sha,source_sha,subject_sha,validation_sha,dispositions_sha,templates_sha,precedence_sha,faults_sha,cases_sha,base_fixture_sha,fixture_image_sha,tool_pins_sha,run_nonce,root_identity,case_count,failed_count,verdict
case_fields=case_id,kind,disposition_id,class_id,stage,mutation_or_fault,repair,expected_exit,observed_exit,stdout_sha256,stderr_sha256,pre_state_sha256,post_state_sha256,result
case_count_rule=147-disposition+50-precedence+12-fault=209,each-required-ID-exactly-once,canonical-kind-then-numeric-order
bounds=header-8192-bytes,case-line-2048-bytes,total-524288-bytes,stdout+stderr-per-case-65536-bytes
identity_rule=all-SHA-256-nonzero-lowercase+exact-selected-by-controller,controller+source-exact-run,run-nonce+root-nonzero+fresh
anti_replay_rule=run-nonce+root+controller+source+fixture-image+tool-pins-tuple-never-reused,no-cross-revision-evidence
result_rule=pass-only-when-observed-exit+output+filesystem-delta-equal-case-oracle,failed-count-zero-required
verdict_rule=mechanically-verified-not-reviewed-not-ready-or-normalized-not-ready,never-ready+accepted
failure_rule=missing+extra+duplicate+reordered+malformed+oversized+zero+stale+self-attested+mutable+aliased+replayed-reject
no_success_effect=lock+inventory+profile+gate+readiness+workflow+GitHub+compiler-use+helper-build-unchanged
local_rule=text+hash+structure-check-only;never-run-verifier+controller+container+compiler+helper+target+VM+emulator-on-Mac
