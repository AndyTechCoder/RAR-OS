schema=rar-alpha-controller-helper-closure-verifier-evidence-v0
status=experimental-C3VA-validated-source-only-unwired
execution_authority=evidence-validator-policy-tests-only,no-verifier+container+workflow+compiler+helper+target-authority
encoding=ASCII-pipe-records,LF-only,no-NUL,no-CR,no-blank-line,one-terminal-LF,canonical-RFC4648-Base64-with-required-padding+no-whitespace+no-alternate-spelling
record_order=one-H-header,then-B+C-blob-stream-for-B000001-through-B000709,then-N-normalized-records-in-logical-order-V001-through-V147+Q001-through-Q050+X001-through-X012
header_record=H|schema|controller_sha|source_sha|subject_sha|verification_contract_sha|validation_sha|dispositions_sha|templates_sha|precedence_sha|faults_sha|cases_sha|base_fixture_sha|fixture_image_sha|tool_pins_sha|run_nonce|root_identity|runtime_case_count|residual_proof_count|logical_relationship_count|blob_count|chunk_count|decoded_bytes|failed_count|verdict
header_domains=schema:rar-alpha-controller-helper-closure-verifier-evidence-v0;all-SHA-256-fields:nonzero-lowercase-64-hex;controller_sha+source_sha:identical-canonical-40-hex-exact-run;run_nonce+root_identity:nonzero-lowercase-64-hex;counts:canonical-decimal-no-leading-zero
count_rule=runtime_case_count:166,residual_proof_count:43,logical_relationship_count:209,blob_count:709,failed_count:0
blob_header_record=B|blob_id|kind|case_id|decoded_bytes|chunk_count|sha256
blob_id_rule=exactly-B000001-through-B000709,increasing,no-gap+duplicate+reorder
blob_domain_rule=kind+case_id+ordinal-is-fixed-by-blob_allocation;decoded_bytes:canonical-decimal-0..16777216;chunk_count:canonical-decimal-1..206741;sha256:nonzero-lowercase-64-hex
chunk_record=C|blob_id|chunk_id|base64_payload
chunk_id_rule=per-blob-exactly-C000001-through-declared-chunk_count,increasing,no-gap+duplicate+reorder,blob_id-equals-open-blob
chunk_payload_rule=decoded-length-0..1436,nonfinal-chunks-exactly-1436-decoded-bytes,final-chunk-may-be-short,concatenated-decoded-length+SHA-256-equal-blob-header
normalized_record=N|ordinal|case_id|kind|result|raw_blob_ids|normalized_sha256
normalized_rule=exactly-209-records,ordinal-001..209,case-id-order-V001..V147+Q001..Q050+X001..X012,kind+raw-blob-IDs-derived-from-reviewed-case-catalog,result:pass,normalized-SHA-256-derived-by-independent-validator-from-canonical-decoded-preimages
runtime_blob_rule=each-of-166-runtime-cases-has-exactly-four-consecutive-blobs:pre-input-topology-envelope,stdout,stderr,post-output-event-resource-envelope
residual_blob_rule=each-of-43-residual-proofs-has-exactly-one-lossless-source-proof-envelope,no-runtime-exit+stdout+stderr+filesystem-result
clean_success_blob_rule=B000001-is-pass-1-lossless-envelope+B000002-is-pass-2-lossless-envelope;between-them-bind-domain+header+tool+fixture-inputs,and-each-carries-topology+canonical-manifest+mount-identities+output+event+resource-bytes
clean_success_validation=validator-recomputes-pass-1+pass-2-canonical-manifests+topology+mount-identities,requires-byte-equality,and-recomputes-every-31-line-verification-receipt-binding
blob_allocation=2-clean-success+166*4-runtime+43*1-residual=709
runtime_case_order=projection-of-V001..V147+Q001..Q050+X001..X012-selecting-117-disposition+37-precedence+12-fault-runtime-rows
residual_case_order=projection-of-V001..V147+Q001..Q050-selecting-30-disposition+13-precedence-residual-rows
raw_preimage_requirements=stdout+stderr,pre+post-mount-inventories,output-inventory+bytes,topology+mount-identities,mutation-or-fault-schedule+trigger+ack+observed-event,resource+timeout+termination,raw-to-normalized-projection
residual_preimage_requirements=case-id+catalog+reason+source+proof-identities+review-verdict+lossless-source+proof-bytes,no-runtime-mutation+observed-exit+stdout+stderr+filesystem-result
decoded_total_max=296816640
base64_payload_total_max=395755520
base64_bound=4*ceil(decoded_total/3),at-most-395755520
chunk_decoded_max=1436
chunk_count_max=206741
blob_count_exact=709
blob_decoded_max=16777216
blob_header_max=256
header_max=8192
normalized_record_count_exact=209
normalized_record_max=2048
logical_record_max=207660
evidence_file_max=440401920
evidence_bound=395755520+206741*128+709*256+209*2048+8192=422836096,below-440401920
artifact_bound=exact-six-file-set-at-most-441473024,below-existing-output-budget-536870912
stdout_stderr_decoded_per_runtime_case_max=65536
streaming_rule=bounded-forward-only-parser,at-most-one-1436-byte-decoded-chunk+fixed-parser-state-in-memory,one-controller-owned-bounded-current-blob-spool,spool-removed-before-next-blob
projection_rule=validator-decodes-losslessly+checks-declared-length+chunk-count+digest,derives-normalized-records+digests-only-from-retained-raw-bytes,rejects-self-asserted-or-cyclic-normalization
anti_alias_rule=every-blob-domain+case+ordinal-tuple-unique,raw_blob_ids-reference-only-the-case-assigned-blob-set,no-cross-case+cross-kind+global-alias
anti_replay_rule=run_nonce+root_identity+controller+source+fixture-image+tool-pins-tuple-never-reused,no-cross-revision+cross-attempt+cross-case-evidence
mutation_rule=empty+alias+replay+truncation+extension+reorder+duplicate+wrong-domain+wrong-length+wrong-hash+malformed-Base64+blob-count+chunk-count+line-count+decoded-total+per-blob+oversize+projection-cycle+raw-normalized-mismatch+cross-case-substitution-all-fail-closed
verdict_rule=mechanically-verified-not-reviewed-not-ready-or-normalized-not-ready,never-ready+accepted
failure_rule=missing+extra+duplicate+reordered+malformed+oversized+zero+stale+self-attested+mutable+aliased+replayed+truncated+contradictory-reject
no_success_effect=lock+inventory+profile+gate+readiness+workflow+GitHub+compiler-use+helper-build-unchanged
consumer_rule=C3VA-validation-is-not-C3V-runtime-evidence+not-C3A-acceptance+not-compiler-or-readiness-authority
local_rule=text+hash+structure-check-only-on-Mac;validator-policy-execution-GitHub-hosted-only;never-run-verifier+controller+container+compiler+helper+target+VM+emulator-on-Mac
