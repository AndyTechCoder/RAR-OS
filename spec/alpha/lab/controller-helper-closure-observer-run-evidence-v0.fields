schema=rar-alpha-controller-helper-closure-observer-run-evidence-schema-v0
status=experimental-complete-C2A-source-only-no-workflow
execution_authority=none;format-and-validator-only
record_schema=rar-alpha-controller-helper-closure-observer-run-evidence-v0
record_path=/evidence/controller-helper-closure-observer-run-evidence.v0
encoding=printable-ASCII-key-value,LF-only,no-CR,no-NUL,no-blank-line,one-terminal-LF
line_count=31
maximum_bytes=4096
field_order=schema,status,repository,ref,event,controller_sha,source_sha,run_id,run_attempt,runner_image_os,runner_image_version,runner_os,runner_arch,oci_image,wrapper_sha256,subject_sha256,fixture_sha256,tool_pins_sha256,case_evidence_sha256,manifest_sha256,receipt_sha256,artifact_name,retention_days,observed_exit,case_evidence_bytes,manifest_bytes,receipt_bytes,output_count,verdict,record_nonce,record_sha256
literal_values=schema:rar-alpha-controller-helper-closure-observer-run-evidence-v0,status:candidate-not-reviewed-not-ready,repository:AndyTechCoder/RAR-OS,ref:refs/heads/main,event:push,runner_image_os:ubuntu24,runner_os:Linux,runner_arch:X64,retention_days:14,observed_exit:0,output_count:4,verdict:candidate-not-reviewed-not-ready
revision_rule=controller_sha+source_sha:identical-nonzero-lowercase-hex-exactly-40
decimal_rule=run_id+run_attempt+case_evidence_bytes+manifest_bytes+receipt_bytes:canonical-positive-decimal-1..20-digits,no-leading-zero
digest_rule=oci-image-suffix+wrapper+subject+fixture+tool-pins+case-evidence+manifest+receipt+record-nonce+record-sha:nonzero-lowercase-hex-exactly-64
runner_version_rule=ASCII-digits-and-dots-1..64,starts+ends-digit,no-adjacent-dot
record_digest_rule=record_sha256-is-SHA256-of-the-exact-first-30-lines-in-field-order-with-each-line-LF-terminated;line-31-is-excluded;no-alternate-serialization
file_binding_rule=validator-hashes-the-four-trusted-inputs+three-observer-outputs-and-binds-exact-byte-counts;producer-values-are-not-attestation
output_set_rule=exactly-controller-helper-closure-observer.cases.v0+controller-helper-closure.sha256+controller-helper-closure.receipt+controller-helper-closure-observer-run-evidence.v0;regular+non-symlink+single-link+no-extra-entry
bounds_rule=case-evidence-1..32768,manifest-1..1048576,receipt-1..4096,record-1..4096
anti_replay_rule=canonical-main-push+exact-controller-source-equality+trusted-run-id+run-attempt+nonzero-controller-selected-record-nonce+derived-artifact-name
producer_validator_rule=outer-controller-produces-record;independent-validator-recomputes-input+output-digests+sizes+record-hash-from-trusted-context-before-retention
artifact_rule=name:controller-helper-closure-observer-<run-id>-<run-attempt>,retention-days:14,no-overwrite,exact-four-files,transport-only
verdict_rule=candidate-not-reviewed-not-ready;mechanical-validation-never-authorizes-lock+inventory+profile+gate+readiness+compiler-use
failure_rule=missing+extra+duplicate+reordered+bad-key+CR+NUL+non-ASCII+blank-line+malformed-decimal+malformed-digest+malformed-runner-version+stale+cross-revision+self-attested+zero+aliased+oversized+wrong-output+wrong-artifact+ready-substitution+invalid-case-evidence-reject
local_rule=source+fixture+syntax-inspection-only;contextual-validation+mutation-cloud-only;no-Mac-or-SSD-write+execution
replacement_rule=experimental-host-evidence,not-target-format,version-before-change
