schema=rar-alpha-controller-helper-closure-acceptance-v0
status=experimental-schema-only-no-instance
authority=C3A-separately-reviewed-instance-only
required_fields=schema,controller_sha,source_sha,observer_sha,verifier_sha,observation_receipt_sha,verification_receipt_sha,candidate_manifest_sha,topology_sha,tool_pins_sha,compiler_sha,compiler_closure_sha,licenses_sha,provenance_sha,acquisition_sha,retained_bytes_sha,runtime_cases_sha,fault_verdict_sha,observer_evidence_sha,verifier_evidence_sha,run_nonce,observation_nonce,verification_nonce,observation_root,verification_root,status
identity_rule=all-identities-nonzero-lowercase-SHA-256+controller-selected+byte-verified,all-nonces+roots-nonzero+pairwise-distinct
revision_rule=controller+source+observer+verifier+receipts+manifest+evidence-same-reviewed-revision,no-cross-revision
provenance_rule=compiler+closure+licenses+upstream-provenance+authenticated-acquisition+retained-bytes-all-bound
runtime_rule=complete-observer-cases+147-dispositions+50-precedence+12-faults,failed-count-zero,normalized-verdict-exact
topology_rule=immutable-fixture-image+read-only-subject+private-scratch+controller-inaccessible-after-launch+network-none+credential-none
anti_replay_rule=receipt+evidence+nonce+root+revision-tuple-unique,no-prior-acceptance-reuse
producer_rule=trusted-outer-controller-after-independent-observer+verifier-termination,never-subject-self-attested
rejection_rule=missing+zero+stale+cross-revision+self-attested+mutable+incomplete+replayed+aliased+mechanical-exact-set-only-reject
status_rule=schema-cannot-authorize;only-reviewed-C3A-instance-may-set-compiler-closure-accepted
effect_rule=no-lock+inventory+profile+gate+readiness+workflow+compiler-use+helper-build-update
local_rule=text+hash+structure-check-only;never-run-or-acquire-on-Mac
