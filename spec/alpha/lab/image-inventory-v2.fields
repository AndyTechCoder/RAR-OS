schema=rar-alpha-image-inventory-schema-v2
status=experimental-inactive
instance_schema=rar-alpha-image-inventory-v2
roles=build,reference,launch
required_field|schema|literal:rar-alpha-image-inventory-v2
required_field|role|enum:build,reference,launch
required_field|image_oci_digest|oci-digest
required_field|base_oci_digest|oci-digest
required_field|source_epoch|positive-integer
required_field|entry_count|integer:1..256
entry_field|ordinal|u16:1..256
entry_field|kind|enum:executable,library,data,license
entry_field|path|canonical-role-root-path
entry_field|sha256|lowercase-sha256
entry_field|bytes|u64:1..1073741824
entry_field|license|ascii-token
entry_field|provenance|https-url-or-rar-source
canonical_order=ordinal-ascending,path-ascending
role_root|build|/opt/rar-toolchain
role_root|reference|/opt/rar-reference
role_root|launch|/opt/rar-lab
role_presence|build|compiler,linker
role_absence|build|reference,reference-harness,qemu,firmware,qmp-client
role_presence|reference|reference-1,reference-2,reference-harness
role_absence|reference|source,compiler,linker,qemu,firmware,qmp-client
role_presence|launch|qemu,firmware,qmp-client
role_absence|launch|source,compiler,linker,reference,reference-harness
validation=complete-file-inventory,no-symlinks,no-hardlink-aliases,no-unlisted-executable,no-setuid,no-setgid,no-device-node
reproducibility=two-independent-byte-identical-oci-exports

