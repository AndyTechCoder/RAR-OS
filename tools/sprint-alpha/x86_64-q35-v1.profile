schema=rar-development-machine-profile-v1
architecture=x86_64
machine=q35
acceleration=tcg
cpu=qemu64
guest_cpu_count=1
guest_memory_mib=256
firmware_mode=uefi-pflash-readonly
graphics=std-vga
keyboard=usb-kbd
pointer=usb-tablet
serial=stdio
monitor=qmp-unix
network=none
audio=none
reboot=disabled
snapshot=true
host_sharing=none
passthrough=none
