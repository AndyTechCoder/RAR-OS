#!/bin/sh
set -eu

requested_command=${1-}
case "$requested_command" in
    run)
        printf '%s\n' \
            'rarbuild-refusal-v1' \
            'reason=run-refusal-only' \
            'certification=not-approved' \
            'owner_authorization=not-approved' \
            'resolver_invoked=false' \
            'spawner_invoked=false' \
            'target_execution=not-attempted'
        exit 73
        ;;
    boot | launch | exec | execute | emulate | emulator | qemu | qemu-system-x86_64 | qemu-system-aarch64 | qemu-system-arm | delegate | env | sudo | sh | bash | zsh | cargo | make | ninja | python | python3 | vm | guest | target | */run | */boot | */launch | *qemu* | *emulator* | */env | */sudo | */sh | */bash | */zsh | */cargo | */python | */python3)
        printf '%s\n' \
            'rarbuild-refusal-v1' \
            'reason=execution-alias-refused' \
            'resolver_invoked=false' \
            'spawner_invoked=false' \
            'target_execution=not-attempted'
        exit 73
        ;;
    test)
        if [ "$#" -ne 1 ]; then
            printf '%s\n' \
                'rarbuild-refusal-v1' \
                'reason=execution-capable-test-mode-refused' \
                'resolver_invoked=false' \
                'spawner_invoked=false' \
                'target_execution=not-attempted'
            exit 73
        fi
        ;;
    check | build | image | evidence)
        if [ "$#" -ne 1 ]; then
            printf '%s\n' \
                'rarbuild-invalid-v1' \
                'reason=command-does-not-accept-arguments'
            exit 64
        fi
        ;;
    '')
        printf '%s\n' \
            'rarbuild-invalid-v1' \
            'reason=command-required'
        exit 64
        ;;
    *)
        printf '%s\n' \
            'rarbuild-invalid-v1' \
            'reason=unknown-command'
        exit 64
        ;;
esac

case "$0" in
    */*) script_directory=${0%/*} ;;
    *)
        echo "rarbuild requires invocation through an explicit checkout path" >&2
        exit 2
        ;;
esac
[ ! -L "$0" ] || {
    echo "rarbuild script must not be a symbolic link" >&2
    exit 2
}
logical_script_directory=$(CDPATH= cd -- "$script_directory" && pwd -L)
physical_script_directory=$(CDPATH= cd -- "$script_directory" && pwd -P)
[ "$logical_script_directory" = "$physical_script_directory" ] || {
    echo "rarbuild refuses a symlink-aliased script path" >&2
    exit 2
}
logical_root=$(CDPATH= cd -- "$logical_script_directory/../.." && pwd -L)
root=$(CDPATH= cd -- "$physical_script_directory/../.." && pwd -P)
[ "$logical_root" = "$root" ] || {
    echo "rarbuild refuses a symlink-aliased repository root" >&2
    exit 2
}
[ ! -L "$root" ] || {
    echo "rarbuild repository root must not be a symbolic link" >&2
    exit 2
}
for marker in Cargo.toml AGENTS.md docs/approval-record.md docs/host-safety.md docs/tasks/release-0.md; do
    if [ ! -f "$root/$marker" ] || [ -L "$root/$marker" ]; then
        echo "rarbuild repository marker is absent or unsafe: $marker" >&2
        exit 2
    fi
done
if [ -L "$root/.git" ] || { [ ! -d "$root/.git" ] && [ ! -f "$root/.git" ]; }; then
    echo "rarbuild requires a regular .git directory or worktree file" >&2
    exit 2
fi
bootstrap_library=$root/tools/rarbuild/bootstrap-lib.sh
[ -f "$bootstrap_library" ] && [ ! -L "$bootstrap_library" ] || {
    echo "rarbuild bootstrap library is absent or unsafe" >&2
    exit 2
}
. "$bootstrap_library"

rar_file_has_exact_line "$root/docs/approval-record.md" 'Status: Approved' || {
    echo "rarbuild approval marker mismatch" >&2
    exit 2
}
rar_file_has_exact_line "$root/docs/approval-record.md" 'Approval: approved' || {
    echo "rarbuild approval statement mismatch" >&2
    exit 2
}
rar_file_has_exact_line "$root/docs/tasks/release-0.md" 'Status: Ready — Gate 0 owner approval recorded 2026-07-16' || {
    echo "rarbuild Release 0 task marker mismatch" >&2
    exit 2
}
rar_file_has_exact_line "$root/docs/host-safety.md" 'Status: Mandatory and effective immediately' || {
    echo "rarbuild host-safety marker mismatch" >&2
    exit 2
}
rar_load_local_bootstrap_root "$root" || {
    echo "rarbuild bootstrap trust root is absent, malformed, or unsafe" >&2
    exit 2
}
cd "$root"

for path in out out/r0 out/r0/host-tools out/r0/tmp; do
    if [ -L "$path" ]; then
        echo "rarbuild output path must not be a symbolic link: $path" >&2
        exit 2
    fi
done

rar_root=$root
rar_prepare_output_parent "$root/out/r0" || exit 2
rar_prepare_output_parent "$root/out/r0/host-tools" || exit 2
rar_prepare_output_parent "$root/out/r0/tmp" || exit 2
bootstrap_directory=$root/out/r0/host-tools/rarbuild-bootstrap-$PPID-$$
"$bootstrap_mkdir_path" -m 700 "$bootstrap_directory" || {
    echo "rarbuild refused a non-exclusive bootstrap output directory" >&2
    exit 2
}
[ ! -L "$bootstrap_directory" ] || exit 2
resolved_bootstrap_directory=$(CDPATH= cd -- "$bootstrap_directory" && pwd -P)
[ "$resolved_bootstrap_directory" = "$bootstrap_directory" ] || exit 2
rar_compile_host_rust \
    tools/rarbuild/src/main.rs \
    "$bootstrap_directory/rarbuild"
RAR_BOOTSTRAP_BOUNDARY=$bootstrap_boundary
export RAR_BOOTSTRAP_BOUNDARY
exec "$bootstrap_directory/rarbuild" "$@"
