schema=rar-build-plan-v3
source_revision=<lowercase-git-commit-id>
source_tree=<lowercase-git-tree-id>
worktree_state=clean
source_inputs_sha256=<lowercase-sha256>
tool_lock_sha256=<lowercase-sha256>
configuration=release-0-host-scaffold
targets=aarch64-unknown-none,thumbv8m.main-none-eabi,x86_64-unknown-none
output_root=out/r0
target_linked_dependencies=none
target_artifacts=not-produced
external_lld=<pin-state>
toolchain_certification=<lock-complete-or-incomplete>
reproducibility_gate=deferred-mandatory-before-release-0-close
execution=forbidden
