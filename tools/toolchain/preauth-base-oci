#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
cd "$root"
[ "$#" -eq 4 ] && [ "$1" = --canonicalize ] || { printf '%s\n' 'preauth-base-oci:usage-refused' >&2; exit 73; }
if [ -x /usr/local/rustup/toolchains/1.95.0-x86_64-unknown-linux-gnu/bin/rustc ]; then
 rustc_path=/usr/local/rustup/toolchains/1.95.0-x86_64-unknown-linux-gnu/bin/rustc
else
 rustc_path=$(command -v rustc) || { printf '%s\n' 'preauth-base-oci:rustc-unavailable' >&2; exit 73; }
fi
# Build into an ephemeral repository-local directory: the workspace mount is executable
# (the container /tmp tmpfs is noexec), and the directory is removed on every exit so the
# repository byte-state is identical before and after any refusal.
mkdir -p out/r0/preauth
build_dir=$(mktemp -d out/r0/preauth/.build-preauth-base-oci.XXXXXX) || { printf '%s\n' 'preauth-base-oci:build-boundary' >&2; exit 73; }
trap 'rm -rf "$build_dir"' 0 1 2 15
"$rustc_path" --edition=2024 -O tools/toolchain/preauth-base-oci.rs -o "$build_dir/preauth-base-oci"
{
 printf '%s\n' schema=rar-preauth-input-producer-tools-v1
 printf 'tool=%s|%s\n' "$rustc_path" "$(sha256sum "$rustc_path" | cut -d ' ' -f 1)"
} > "$4"
set +e
"$build_dir/preauth-base-oci" --canonicalize "$2" "$3"
status=$?
set -e
exit "$status"
