#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
[ "$#" -eq 4 ] && [ "$1" = --canonicalize ] || { printf '%s\n' 'preauth-base-oci:usage-refused' >&2; exit 73; }
. "$root/tools/toolchain/preauth-build-root.sh"
if [ -n "${RAR_PREAUTH_CONTAINER_IMAGE-}" ]; then
    rustc_path=$(preauth_build_pinned_container_rustc_path "$root")
else
    rustc_path=$(preauth_build_pinned_rustc_path "$root")
fi || { printf '%s\n' 'preauth-base-oci:pinned-rustc' >&2; exit 73; }
preauth_build_root_create "$root" preauth-base-oci preauth-base-oci
preauth_build_install_traps
preauth_build_run_child "$rustc_path" --edition=2024 -O "$root/tools/toolchain/preauth-base-oci.rs" -o "$PREAUTH_BUILD_DIR/preauth-base-oci" \
 >"$PREAUTH_BUILD_DIR/compiler.stdout" 2>"$PREAUTH_BUILD_DIR/compiler.stderr" || preauth_build_refuse compiler-failed
preauth_build_root_probe_executable "$PREAUTH_BUILD_DIR/preauth-base-oci"
preauth_build_run_child_in_directory "$root" "$PREAUTH_BUILD_DIR/preauth-base-oci" --canonicalize "$2" "$3"
status=$?
[ "$status" -eq 0 ] || exit "$status"
[ ! -e "$root/$4" ] && [ ! -L "$root/$4" ] || preauth_build_refuse tool-record-collision
set -C
{
 printf '%s\n' schema=rar-preauth-input-producer-tools-v1
 printf 'tool=%s|%s\n' "$rustc_path" "$(sha256sum "$rustc_path" | cut -d ' ' -f 1)"
} > "$root/$4" || preauth_build_refuse tool-record-create
set +C
exit "$status"
