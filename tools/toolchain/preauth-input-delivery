#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
cd "$root"
phase=initialization
host_exit(){
 status=$?
 trap - 0 1 2 15
 if [ "$status" -ne 0 ]; then printf 'preauth-input-delivery:phase=%s:status=%s\n' "$phase" "$status" >&2; fi
 exit "$status"
}
trap host_exit 0 1 2 15
run_phase(){
 phase=$1
 shift
 set +e
 "$@"
 status=$?
 set -e
 [ "$status" -eq 0 ] || exit "$status"
}
[ "${1-}" = --acquire-pair ] && [ "$#" -eq 1 ] || { phase=usage; exit 73; }
run_phase cutover tools/ci/check-preauth-cutover.sh
phase=output-parent
mkdir -p out/r0/preauth/input-delivery
[ -d out/r0/preauth/input-delivery ] && [ ! -L out/r0/preauth/input-delivery ] || exit 73
run_phase producer-one tools/toolchain/preauth-input-producer --produce one 1>&2
run_phase producer-two tools/toolchain/preauth-input-producer --produce two 1>&2
phase=host-validation
one=$(sha256sum out/r0/preauth/input-delivery/one/preauth-input-bundle-v1.tar | cut -d ' ' -f 1)
two=$(sha256sum out/r0/preauth/input-delivery/two/preauth-input-bundle-v1.tar | cut -d ' ' -f 1)
[ -n "$one" ] || exit 73
if [ "$one" != "$two" ]; then
 diagnostic=out/r0/preauth/input-delivery/.pair-diagnostic
 mkdir -m 700 "$diagnostic"
 tar -xOf out/r0/preauth/input-delivery/one/preauth-input-bundle-v1.tar objects.v1 > "$diagnostic/one.objects"
 tar -xOf out/r0/preauth/input-delivery/two/preauth-input-bundle-v1.tar objects.v1 > "$diagnostic/two.objects"
 [ "$(wc -l < "$diagnostic/one.objects" | tr -d ' ')" -le 128 ] || exit 73
 [ "$(wc -l < "$diagnostic/two.objects" | tr -d ' ')" -le 128 ] || exit 73
 printf 'preauth-input-delivery:bundle-mismatch:one=%s:two=%s\n' "$one" "$two" >&2
 LC_ALL=C comm -3 "$diagnostic/one.objects" "$diagnostic/two.objects" | sed -n '1,80p' >&2
 rm -f "$diagnostic/one.objects" "$diagnostic/two.objects"
 rmdir "$diagnostic"
 exit 73
fi
printf 'input_bundle_sha256=%s\n' "$one"
phase=complete
