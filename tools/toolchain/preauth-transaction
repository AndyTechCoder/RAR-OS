#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
cd "$root"
[ "$#" -eq 2 ] && [ "$1" = --prepare ] || { printf '%s\n' 'preauth-transaction:usage-refused' >&2; exit 73; }
if [ -x /usr/local/rustup/toolchains/1.95.0-x86_64-unknown-linux-gnu/bin/rustc ]; then
 rustc_path=/usr/local/rustup/toolchains/1.95.0-x86_64-unknown-linux-gnu/bin/rustc
else
 rustc_path=$(command -v rustc) || { printf '%s\n' 'preauth-transaction:rustc-unavailable' >&2; exit 73; }
fi
# Build only inside an ephemeral non-repository boundary supplied by the caller: CI containers
# mount an executable tmpfs and pass it as RAR_PREAUTH_BUILD_ROOT (the container /tmp is noexec);
# elsewhere the system temporary directory is used. Nothing is created inside the repository, so
# every refusal leaves the complete repository tree byte-identical.
build_root=${RAR_PREAUTH_BUILD_ROOT:-${TMPDIR:-/tmp}}
build_dir=$(mktemp -d "$build_root/preauth-transaction.XXXXXX") || { printf '%s\n' 'preauth-transaction:build-boundary' >&2; exit 73; }
trap 'rm -rf "$build_dir"' 0 1 2 15
"$rustc_path" --edition=2024 tools/toolchain/preauth-transaction.rs -o "$build_dir/preauth-transaction"
set +e
"$build_dir/preauth-transaction" "$@"
status=$?
set -e
exit "$status"
