#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
[ "$#" -eq 3 ] && [ "$1" = --verify ] || { printf '%s\n' 'preauth-transfer-telemetry:usage-refused' >&2; exit 73; }
. "$root/tools/toolchain/preauth-build-root.sh"
rustc_path=$(preauth_build_pinned_rustc_path "$root") || { printf '%s\n' 'preauth-transfer-telemetry:pinned-rustc' >&2; exit 73; }
preauth_build_root_create "$root" preauth-transfer-telemetry preauth-transfer-telemetry
preauth_build_install_traps
preauth_build_run_child "$rustc_path" --edition=2024 -O "$root/tools/toolchain/preauth-transfer-telemetry.rs" \
    -o "$PREAUTH_BUILD_DIR/preauth-transfer-telemetry" \
    >"$PREAUTH_BUILD_DIR/compiler.stdout" 2>"$PREAUTH_BUILD_DIR/compiler.stderr" || preauth_build_refuse compiler-failed
preauth_build_root_probe_executable "$PREAUTH_BUILD_DIR/preauth-transfer-telemetry"
preauth_build_run_child_in_directory "$root" "$PREAUTH_BUILD_DIR/preauth-transfer-telemetry" --verify "$2" "$3"
status=$?
exit "$status"
