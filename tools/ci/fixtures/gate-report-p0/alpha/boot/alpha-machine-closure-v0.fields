topology_rule=exact-set,missing-reject,extra-reject,multifunction-bits-match,bridge-expansion-forbidden
bus_master_capable_count=10
bus_master_disable_order=00:01.0,00:1a.0,00:1a.1,00:1a.2,00:1a.7,00:1d.0,00:1d.1,00:1d.2,00:1d.7,00:1f.2
bus_master_disable_rule=clear-command-bit-2,read-back-same-function,bit-2-zero,all-other-command-bits-unchanged
ahci_bdf=00:1f.2
ahci_vendor_device=8086:2922
ahci_class=010601
ahci_bar=BAR5,mmio32,base:0xfebf1000,bytes:4096,prefetchable:no
ahci_boot_device_binding=UEFI-device-path-controller-BDF-equals-00:1f.2,port:0,duplicate-or-ambiguous-reject
ahci_cap_np=5
ahci_pi=0x0000003f
ahci_port_order=0,1,2,3,4,5
ahci_stop_step|1|for-each-implemented-port-ascending|clear-PxCMD.ST
ahci_stop_step|2|for-each-implemented-port-ascending|wait-PxCMD.CR-zero,maximum-polls:100000
ahci_stop_step|3|for-each-implemented-port-ascending|clear-PxCMD.FRE
ahci_stop_step|4|for-each-implemented-port-ascending|wait-PxCMD.FR-zero,maximum-polls:100000
ahci_stop_step|5|controller|clear-GHC.AE-no,retain-AE,interrupts-disabled
ahci_idle_predicate=all-implemented-ports-PxCMD.ST+CR+FRE+FR-zero,no-command-issued-after-final-file-read
closure_order=last-UEFI-file-read,ExitBootServices,private-CR3+stack-switch,exact-PCI-enumeration,AHCI-stop,bus-master-disable+readback,staged-source-rehash,Recovery-identity-check+load,full-disabled-vector-recheck,Recovery-entry
closure_record_schema=rar-alpha-machine-closure-record-v0
closure_record_bytes=512
closure_record_field|0|magic|bytes:8|RARCLSR0
closure_record_field|8|version|u16|0
closure_record_field|10|header_bytes|u16|512
closure_record_field|12|total_bytes|u32|512
closure_record_field|16|pci_inventory_sha256|bytes:32|computed
closure_record_field|48|disabled_vector_sha256|bytes:32|computed
closure_record_field|80|source_set_sha256|bytes:32|computed-after-closure
closure_record_field|112|ahci_bdf|u32|0x0000fa00
closure_record_field|116|ahci_pi|u32|0x0000003f
closure_record_field|120|flags|u32|zero
closure_record_field|124|reserved|bytes:388|zero
closure_record_rights=Root-write-during-closure,Recovery-read-only-after-entry,Nucleus-none,Core-none,applications-none
rehash_source_order=BOOTX64.EFI,RECOVERY.ELF,NUCLEUS.ELF,CORE.IMG,COMPONENTS.RAC,SYSTEM.RAS,PRESERVED.RAP
recheck_rule=all-AHCI-engines-idle,all-declared-bus-master-bits-zero,inventory-byte-identical,immediately-before-Recovery-entry
failure_rule=first-global-predicate,empty-map+thread+capability+device-effect-log,serial-one-line,halt
authority_transfer=pci:none,ahci:none,boot-device:none,DMA:none,closure-record:Recovery-read-only
scope_rule=private-experimental-profile-only,no-general-q35,no-general-AHCI,no-physical-support
