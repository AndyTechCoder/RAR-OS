schema=rar-alpha-state-slots-v0
status=experimental-pending-review
slot_count=2
selector_count=2
slot_state_set=unredeemed,bound,rebindable,revoked
event_set=create-matching,create-wrong,redeem-matching,redeem-wrong,redeem-stale,service-exit,service-crash,restart-matching,restart-wrong,source-integrity-failure,reconstruction-teardown
prestate_event_set=selector-malformed,token-malformed,token-allocation-failure,derived-handle-allocation-failure,mutable-destination-allocation-failure
prestate_event_rule|selector-malformed|all-four-states|reject-E-SELECTOR,no-state+token+handle+capability+effect-change
prestate_event_rule|token-malformed|all-four-states|reject-E-TOKEN,no-state+token+handle+capability+effect-change
prestate_event_rule|token-allocation-failure|unredeemed+rebindable|reject-E-ALLOCATION,no-state+token+handle+capability+effect-change
prestate_event_rule|token-allocation-failure|bound+revoked|normal-state-error-wins-before-allocation,no-allocation-attempt
prestate_event_rule|derived-handle-allocation-failure|unredeemed+rebindable-with-live-token|reject-E-ALLOCATION,live-token-retained,no-state+handle+capability+effect-change
prestate_event_rule|derived-handle-allocation-failure|bound+revoked|normal-state-error-wins-before-allocation,no-allocation-attempt
prestate_event_rule|mutable-destination-allocation-failure|first-successful-redeem-before-publication|reject-E-ALLOCATION,revoke-unpublished-handle+token,slot-rebindable,no-external-effect
prestate_event_rule|mutable-destination-allocation-failure|all-other-contexts|normal-state-error-wins-before-allocation,no-allocation-attempt
auxiliary_token_state=none-or-one-live-token,stored-inside-Nucleus-slot,never-Core-visible,not-a-fifth-slot-state
token_state_invariant=bound-implies-no-redeem-token+one-derived-handle,revoked-implies-none,unredeemed+rebindable-at-most-one-live-token
event_classification_rule=redeem-matching-only-after-selector+token-framing+role+identity+incarnation+live-token-pass,no-live-token-classifies-redeem-stale
object_kind|state-slot|Nucleus-owned,contains-source-read+expected-identity+state,never-mapped
object_kind|opaque-selector|Core-positioned,use-only-in-create-service,nonreadable,nonclonable,nondelegable,nonretargetable,nonrevocable
object_kind|redeem-token|service-incarnation-bound,nondelegable,Core-never-possesses-or-observes
object_kind|derived-source-handle|read+map-read,no-write,no-clone,no-delegate,no-retarget,revoked-on-exit
object_kind|mutable-destination|service-owned,separate-from-immutable-source,quarantine-on-terminal-revoke
slot|0|system-state-service|outer-source-role:system-state|selector-position:1|expected-identity:compiled-system-literal
slot|1|preserved-state-service|outer-source-role:preserved-state|selector-position:2|expected-identity:compiled-preserved-literal
core_initial_capability_position|0|component-source|read+map-read,immutable,nonexecutable
core_initial_capability_position|1|system-selector|create-service-use-only
core_initial_capability_position|2|preserved-selector|create-service-use-only
core_initial_capability_count=3
core_forbidden_authority=state-read,state-map,state-write,token-possession,token-observation,redeem,clone,delegate,retarget,revoke,mutable-destination
token_injection=Nucleus-direct-to-new-verified-service-incarnation,after-three-way-identity-match,before-first-thread-runnable
redeem_atomicity=compare-identity+role+slot-state+incarnation-and-create-derived-handle-one-linearization-point
concurrency_rule=exactly-one-matching-winner,losers-stale-no-effect,allocation-failure-no-state-change
transition|unredeemed|create-matching|unredeemed|revoke-prior-live-token-if-any+inject-exactly-one-fresh-token|ok
transition|unredeemed|create-wrong|unredeemed|none|identity-mismatch
transition|unredeemed|redeem-matching|bound|consume-live-token+create-derived-read-handle+bind-incarnation|ok
transition|unredeemed|redeem-wrong|unredeemed|none|identity-mismatch
transition|unredeemed|redeem-stale|unredeemed|none|stale-token
transition|unredeemed|service-exit|unredeemed|revoke-token-if-any|ok
transition|unredeemed|service-crash|unredeemed|revoke-token-if-any|ok
transition|unredeemed|restart-matching|unredeemed|inject-fresh-token|ok
transition|unredeemed|restart-wrong|unredeemed|none|identity-mismatch
transition|unredeemed|source-integrity-failure|revoked|destroy-slot+selector+token+handles,quarantine-mutable|terminal-revoked
transition|unredeemed|reconstruction-teardown|revoked|destroy-slot+selector+token+handles,quarantine-mutable|terminal-revoked
transition|bound|create-matching|bound|none|already-bound
transition|bound|create-wrong|bound|none|identity-mismatch
transition|bound|redeem-matching|bound|none|already-bound
transition|bound|redeem-wrong|bound|none|identity-mismatch
transition|bound|redeem-stale|bound|none|stale-token
transition|bound|service-exit|rebindable|revoke-derived+token,retain-slot+selector|ok
transition|bound|service-crash|rebindable|revoke-derived+token,retain-slot+selector|ok
transition|bound|restart-matching|bound|none|incarnation-still-bound
transition|bound|restart-wrong|bound|none|identity-mismatch
transition|bound|source-integrity-failure|revoked|destroy-slot+selector+token+handles,quarantine-mutable|terminal-revoked
transition|bound|reconstruction-teardown|revoked|destroy-slot+selector+token+handles,quarantine-mutable|terminal-revoked
transition|rebindable|create-matching|rebindable|revoke-prior-live-token-if-any+inject-exactly-one-fresh-token|ok
transition|rebindable|create-wrong|rebindable|none|identity-mismatch
transition|rebindable|redeem-matching|bound|consume-live-token+create-derived-read-handle+bind-new-incarnation|ok
transition|rebindable|redeem-wrong|rebindable|none|identity-mismatch
transition|rebindable|redeem-stale|rebindable|none|stale-token
transition|rebindable|service-exit|rebindable|revoke-token-if-any|ok
transition|rebindable|service-crash|rebindable|revoke-token-if-any|ok
transition|rebindable|restart-matching|rebindable|inject-fresh-token|ok
transition|rebindable|restart-wrong|rebindable|none|identity-mismatch
transition|rebindable|source-integrity-failure|revoked|destroy-slot+selector+token+handles,quarantine-mutable|terminal-revoked
transition|rebindable|reconstruction-teardown|revoked|destroy-slot+selector+token+handles,quarantine-mutable|terminal-revoked
transition|revoked|create-matching|revoked|none|terminal-revoked
transition|revoked|create-wrong|revoked|none|terminal-revoked
transition|revoked|redeem-matching|revoked|none|terminal-revoked
transition|revoked|redeem-wrong|revoked|none|terminal-revoked
transition|revoked|redeem-stale|revoked|none|terminal-revoked
transition|revoked|service-exit|revoked|none|terminal-revoked
transition|revoked|service-crash|revoked|none|terminal-revoked
transition|revoked|restart-matching|revoked|none|terminal-revoked
transition|revoked|restart-wrong|revoked|none|terminal-revoked
transition|revoked|source-integrity-failure|revoked|none|terminal-revoked
transition|revoked|reconstruction-teardown|revoked|none|terminal-revoked
allocation_boundary|token|failure-leaves-state+capability-table+effect-log-unchanged
allocation_boundary|derived-handle|failure-leaves-state+capability-table+effect-log-unchanged
allocation_boundary|mutable-destination|failure-revokes-new-handle+token,slot-rebindable,no-alias
audit_rule=bounded-event-only,slot-role+state+result,no-source-bytes,no-token-value
revocation_limit=removes-future-authority-and-mappings,no-claim-to-erase-observed-information
