schema=rar-alpha-controller-helper-closure-observer-case-evidence-schema-v0
status=experimental-complete-C2A-source-only-no-workflow
execution_authority=none;format-only
record_schema=rar-alpha-controller-helper-closure-observer-case-evidence-v0
encoding=printable-ASCII-pipe-delimited,LF-only,no-CR,no-NUL,one-terminal-LF
header=schema=rar-alpha-controller-helper-closure-observer-case-evidence-v0;case_count=21
row=case|id|controller-sha|source-sha|subject-sha|fixture-sha|tool-pins-sha|nonce|root-id|observed-exit|stdout-sha|stderr-sha|result|verdict
case_set=O001-through-O021-exactly-once-in-numeric-order
maximum_bytes=32768
identity_rule=controller+source-nonzero-lowercase-hex-40-and-equal;all-SHA256+nonce+root-id-nonzero-lowercase-hex-64;nonce+root-id-distinct-per-case
exit_rule=O001:0;O002-through-O021:1-controller-normalized-rejection;no-other-value
result_rule=O001:pass;O002-through-O021:expected-rejection
verdict_rule=O001:observed-not-reviewed-not-ready;O002-through-O021:normalized-not-ready
effect_rule=no-case-or-aggregate-may-update-lock+inventory+profile+gate+readiness+workflow+GitHub
producer_validator_rule=bounded-harness-produces;outer-validator-independently-checks-exact-set+order+identities+nonce-root-uniqueness+exit-result-verdict-mapping+bytes-before-run-evidence
local_rule=source-only;never-produce-or-validate-runtime-case-evidence-on-Mac-or-SSD
